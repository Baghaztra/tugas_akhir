# ──────────────────────────────────────────────────────
# Backend Environment Variables — Production
# Copy ke .env lalu isi nilai sebenarnya
# ──────────────────────────────────────────────────────

APP_NAME="Backend Rumah Jahit App"

# Database — host "mysql" karena pakai Docker network
SQLALCHEMY_DATABASE_URL="mysql+mysqlconnector://user:password@mysql:3306/tugas_akhir_refactor"

# Base URL backend (untuk generate link upload, dll)
PUBLIC_BASE_URL=http://localhost:8000

# CORS — isi dengan domain frontend Vercel
# Contoh: https://yan.bgztra.my.id,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# JWT — generate dengan: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=1440

# SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rumahjahityan@gmail.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=rumahjahityan@gmail.com
